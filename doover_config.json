{
    "morningstar_prostar_app": {
        "name": "morningstar_prostar_app",
        "display_name": "MorningStar ProStar App",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "An app to monitor and record solar and battery metrics via modbus from a MorningStar ProStar series solar controller.",
        "long_description": "README.md",
        "depends_on": [
            "modbus_interface"
        ],
        "owner_org_key": "36a22e32-ab81-4a39-b400-869d532a052d",
        "image_name": "ghcr.io/getdoover/morningstar-prostar-app:main",
        "container_registry_profile_key": "88953909-e9c4-4f81-9ec0-56239d4b0a2e",
        "build_args": "--platform linux/amd64,linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "system_voltage": {
                    "enum": [
                        12,
                        24,
                        48
                    ],
                    "title": "System Voltage",
                    "x-name": "system_voltage",
                    "x-hidden": false,
                    "x-required": false,
                    "description": "Nominal system voltage of the battery bank the ProStar charges.",
                    "default": 24,
                    "x-position": 0
                },
                "battery_max_ah": {
                    "title": "Battery Max (Ah)",
                    "x-name": "battery_max_ah",
                    "x-hidden": false,
                    "type": "number",
                    "x-required": true,
                    "description": "Rated amp-hour capacity of the battery bank, used to derive remaining Ah.",
                    "x-position": 1
                },
                "modbus_slave_id": {
                    "title": "Modbus Slave ID",
                    "x-name": "modbus_slave_id",
                    "x-hidden": false,
                    "type": "integer",
                    "x-required": true,
                    "description": "Modbus slave/unit ID of the ProStar controller on its RS485 bus.",
                    "x-position": 2
                },
                "modbus_config": {
                    "title": "Modbus Config",
                    "x-name": "modbus_config",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "x-position": 3,
                    "properties": {
                        "bus_type": {
                            "enum": [
                                "serial",
                                "tcp"
                            ],
                            "title": "Bus Type",
                            "x-name": "bus_type",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "serial",
                            "x-position": 1
                        },
                        "name": {
                            "title": "Name",
                            "x-name": "name",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "default",
                            "x-position": 2
                        },
                        "serial_port": {
                            "title": "Serial Port",
                            "x-name": "serial_port",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "/dev/ttyAMA0",
                            "x-position": 3
                        },
                        "serial_baud": {
                            "title": "Serial Baud",
                            "x-name": "serial_baud",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 9600,
                            "x-position": 4
                        },
                        "serial_method": {
                            "enum": [
                                "rtu",
                                "ascii",
                                "socket",
                                "tls"
                            ],
                            "title": "Serial Method",
                            "x-name": "serial_method",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "rtu",
                            "x-position": 5
                        },
                        "serial_data_bits": {
                            "title": "Serial Data Bits",
                            "x-name": "serial_data_bits",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 8,
                            "x-position": 6
                        },
                        "serial_parity": {
                            "enum": [
                                "None",
                                "Even",
                                "Odd"
                            ],
                            "title": "Serial Parity",
                            "x-name": "serial_parity",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "None",
                            "x-position": 7
                        },
                        "serial_stop_bits": {
                            "title": "Serial Stop Bits",
                            "x-name": "serial_stop_bits",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 1,
                            "x-position": 8
                        },
                        "serial_timeout": {
                            "title": "Serial Timeout",
                            "x-name": "serial_timeout",
                            "x-hidden": false,
                            "type": [
                                "number",
                                "null"
                            ],
                            "x-required": false,
                            "default": 0.3,
                            "x-position": 9
                        },
                        "tcp_uri": {
                            "title": "TCP URI",
                            "x-name": "tcp_uri",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "127.0.0.1:5000",
                            "x-position": 10
                        },
                        "tcp_timeout": {
                            "title": "TCP Timeout",
                            "x-name": "tcp_timeout",
                            "x-hidden": false,
                            "type": [
                                "number",
                                "null"
                            ],
                            "x-required": false,
                            "default": 2.0,
                            "x-position": 11
                        }
                    },
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                }
            },
            "additionalElements": true,
            "required": [
                "battery_max_ah",
                "modbus_slave_id",
                "modbus_config"
            ]
        },
        "key": "de97c5e2-38b9-43f3-bd80-040d9375e9af",
        "code_repo_key": null,
        "repo_branch": "main",
        "staging_config": {},
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "voltage": {
                    "name": "voltage",
                    "type": "uiVariable",
                    "displayString": "Battery Voltage",
                    "showActivity": true,
                    "position": 51,
                    "hidden": false,
                    "units": "V",
                    "varType": "float",
                    "currentValue": "$tag.app().b_voltage:number:null",
                    "decPrecision": 2,
                    "live": true
                },
                "batteryPercent": {
                    "name": "batteryPercent",
                    "type": "uiVariable",
                    "displayString": "Battery",
                    "showActivity": true,
                    "position": 52,
                    "hidden": false,
                    "units": "%",
                    "varType": "float",
                    "currentValue": "$tag.app().b_percent:number:null",
                    "decPrecision": 1,
                    "ranges": [
                        {
                            "min": 0,
                            "max": 50,
                            "colour": "yellow",
                            "show_on_graph": true,
                            "label": "Low"
                        },
                        {
                            "min": 50,
                            "max": 75,
                            "colour": "blue",
                            "show_on_graph": true,
                            "label": "Medium"
                        },
                        {
                            "min": 75,
                            "max": 100,
                            "colour": "green",
                            "show_on_graph": true,
                            "label": "High"
                        }
                    ],
                    "live": true
                },
                "chargeLevel": {
                    "name": "chargeLevel",
                    "type": "uiVariable",
                    "displayString": "Battery Charge",
                    "showActivity": true,
                    "position": 53,
                    "hidden": false,
                    "units": "Ah",
                    "varType": "float",
                    "currentValue": "$tag.app().remaining_ah:number:null",
                    "decPrecision": 1,
                    "live": true
                },
                "panelPower": {
                    "name": "panelPower",
                    "type": "uiVariable",
                    "displayString": "Panel Power",
                    "showActivity": true,
                    "position": 54,
                    "hidden": false,
                    "units": "W",
                    "varType": "float",
                    "currentValue": "$tag.app().panel_power:number:null",
                    "decPrecision": 1,
                    "live": true
                },
                "dailyLoad": {
                    "name": "dailyLoad",
                    "type": "uiVariable",
                    "displayString": "Daily Load",
                    "showActivity": true,
                    "position": 55,
                    "hidden": false,
                    "units": "Ah",
                    "varType": "float",
                    "currentValue": "$tag.app().daily_load:number:null",
                    "decPrecision": 1,
                    "live": true
                },
                "dailyCharge": {
                    "name": "dailyCharge",
                    "type": "uiVariable",
                    "displayString": "Panel Charge",
                    "showActivity": true,
                    "position": 56,
                    "hidden": false,
                    "units": "Ah",
                    "varType": "float",
                    "currentValue": "$tag.app().daily_charge:number:null",
                    "decPrecision": 1,
                    "live": true
                },
                "commsWarning": {
                    "name": "commsWarning",
                    "type": "uiWarningIndicator",
                    "displayString": "No communication with solar controller",
                    "position": 57,
                    "hidden": "$tag.app().comms_ok:boolean:true",
                    "currentValue": "$cmds.app().commsWarning",
                    "can_cancel": true
                },
                "details": {
                    "name": "details",
                    "type": "uiSubmodule",
                    "displayString": "Details",
                    "showActivity": true,
                    "position": 61,
                    "hidden": false,
                    "children": {
                        "panelVoltage": {
                            "name": "panelVoltage",
                            "type": "uiVariable",
                            "displayString": "Panel Voltage",
                            "showActivity": true,
                            "position": 58,
                            "hidden": false,
                            "units": "V",
                            "varType": "float",
                            "currentValue": "$tag.app().panel_voltage:number:null",
                            "decPrecision": 2,
                            "live": true
                        },
                        "panelCurrent": {
                            "name": "panelCurrent",
                            "type": "uiVariable",
                            "displayString": "Panel Current",
                            "showActivity": true,
                            "position": 59,
                            "hidden": false,
                            "units": "A",
                            "varType": "float",
                            "currentValue": "$tag.app().panel_current:number:null",
                            "decPrecision": 2,
                            "live": true
                        },
                        "loadCurrent": {
                            "name": "loadCurrent",
                            "type": "uiVariable",
                            "displayString": "Load Current",
                            "showActivity": true,
                            "position": 60,
                            "hidden": false,
                            "units": "A",
                            "varType": "float",
                            "currentValue": "$tag.app().load_current:number:null",
                            "decPrecision": 2,
                            "live": true
                        }
                    }
                }
            }
        }
    }
}